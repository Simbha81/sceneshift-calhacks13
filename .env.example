# Shared hackathon development backend (public URL, not a secret).
# See docs/TEAM_START_HERE.md. UI contributors run pnpm dev only.
VITE_CONVEX_URL=https://bold-lobster-565.convex.cloud
# convex dev writes real deployment configuration into .env.local.
# CONVEX_DEPLOYMENT=dev:your-deployment
# Add these only in Convex server environment settings when integrations exist:
# ANTHROPIC_API_KEY=
# APIFY_TOKEN=
# Never put secrets in VITE_ variables; those are public.

# Optional public MapLibre style URL; default uses OpenStreetMap raster tiles.
VITE_MAP_STYLE_URL=
